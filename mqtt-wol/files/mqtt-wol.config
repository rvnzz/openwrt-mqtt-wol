# mqtt-wol — MQTT to Wake-on-LAN bridge
# LuCI: Services -> MQTT Wake-On-LAN
# Docs: README.md of the mqtt-wol package

config broker 'main'
	option enabled '1'

	# MQTT broker
	option host 'm8.wqtt.ru'
	option port '21236'
	# option username 'u_XXXXXX'
	# option password 'YYYYYYYY'
	option clientid 'openwrt-wol'
	option keepalive '60'
	option tls '0'
	# option ca_file '/etc/ssl/ca-certificates.crt'

	# Optional: publish retained online/offline JSON here
	# option status_topic 'home/wol/openwrt/status'

	# Global Wake-on-LAN defaults
	option broadcast '255.255.255.255'
	option wol_port '9'

	# option debug '0'

# Wake-on-LAN targets.
# topic: payload "1" / "on" / "wake" / "true" triggers the magic packet.
# port / broadcast are optional per-device overrides.
config device 'pc'
	option name 'Desktop PC'
	option mac 'AC:DE:48:00:11:22'
	option topic 'control/pcwol'
	# option port '9'
	# option broadcast '192.168.1.255'
