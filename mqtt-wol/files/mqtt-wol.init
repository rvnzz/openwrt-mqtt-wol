#!/bin/sh /etc/rc.common
#
# mqtt-wol — procd init script
#

START=98
STOP=10
USE_PROCD=1

PROG=/usr/sbin/mqtt-wol

start_service() {
	# gate on uci option mqtt-wol.main.enabled (default: on)
	[ "$(uci -q get mqtt-wol.main.enabled)" = "0" ] && return 0

	procd_open_instance mqtt-wol
	procd_set_param command "$PROG"
	# respawn: 3600s threshold, 5s backoff, unlimited retries
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mqtt-wol"
}
